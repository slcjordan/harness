
FROM golang:1.24 AS builder
ARG PORTAL_VERSION

RUN apt-get update

RUN mkdir -p /go/src/github.com/slcjordan/harness

WORKDIR /go/src/github.com/slcjordan/harness

COPY . .

RUN go build -o /usr/local/bin/harness ./cmd/harness/main.go

FROM ubuntu:24.04

COPY --from=builder /usr/local/bin/harness /usr/local/bin/harness
COPY ./ui/public /srv/harness

ENV HARNESS_HTTPSERVER_FILEROOT=/srv/harness
ENV HARNESS_HTTPSERVER_ADDR=:1984
EXPOSE 1984

CMD harness
