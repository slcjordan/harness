
FROM golang:1.24 AS builder
ARG PORTAL_VERSION

ENV GOPRIVATE=source.vivint.com

RUN apt-get update

RUN mkdir -p /go/src/github.com/slcjordan/harness

WORKDIR /go/src/github.com/slcjordan/harness

COPY . .

RUN go build -o /go/bin/parsepk ./cmd/parsepk

RUN --mount=type=secret,id=testkey,target=/tmp/test_key.go \
    --mount=type=cache,target=/go/pkg/mod \
    parsepk /tmp/test_key.go /tmp/portal_test.key

RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    update-ca-certificates && ls && go build -o /usr/local/bin/worker ./cmd/worker

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y ca-certificates

COPY --from=builder /tmp/portal_test.key /tmp/portal_test.key
COPY --from=builder /usr/local/bin/worker /usr/local/bin/worker

CMD worker

